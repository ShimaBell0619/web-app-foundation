{
  "name": "web-app-foundation",
  "version": "0.6.0",
  "private": true,
  "description": "AI-first shared foundation for web application development.",
  "engines": {
    "node": "^24.20.0 || >=26.0.0"
  },
  "scripts": {
    "foundation:validate": "node scripts/validate-foundation.mjs && node scripts/validate-independent-review.mjs && node scripts/validate-ui-profile.mjs",
    "foundation:test": "node scripts/test-foundation-validator.mjs && node scripts/test-independent-review-contract.mjs && node scripts/test-ui-profile-contract.mjs",
    "foundation:test:web-ci": "node scripts/test-web-ci-contract.mjs",
    "foundation:test:web-pages": "node scripts/test-web-pages-contract.mjs && node scripts/test-pages-bootstrap-contract.mjs",
    "foundation:test:vercel-staging": "node --test scripts/test-vercel-fixed-staging-contract.mjs",
    "foundation:test:release": "node scripts/test-release-cycle.mjs",
    "foundation:release-validate": "node scripts/validate-release-state.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-foundation-version.mjs",
    "version:status": "changeset status",
    "version:tooling": "changeset --version",
    "tag-version": "changeset tag"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "yaml": "2.9.0"
  }
}
